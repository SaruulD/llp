<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="llp_payroll.PayrollSheetField">
        <div class="o_payroll_sheet">
            <div class="o_payroll_scroll">
                <table class="o_payroll_table table table-sm">
                    <thead>
                        <tr>
                            <th class="o_pf_col1">№</th>
                            <th class="o_pf_col2">Employee</th>
                            <t t-foreach="state.rules" t-as="rule" t-key="rule[0]">
                                <th>
                                    <a t-on-click="() => goToRule(rule[0])" href="javascript:void(0)">
                                        <t t-esc="rule[1]"/>
                                    </a>
                                </th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.employees" t-as="emp" t-key="emp[0]">
                            <tr>
                                <td class="o_pf_col1"><t t-esc="emp_index + 1"/></td>
                                <td class="o_pf_col2">
                                    <a t-on-click="() => goToEmployee(emp[0])" href="javascript:void(0)">
                                        <t t-esc="emp[1]"/>
                                    </a>
                                </td>
                                <t t-foreach="state.rules" t-as="rule" t-key="emp[0] + '-' + rule[0]">
                                    <td>
                                        <t t-set="v" t-value="state.employee_values?.[emp[0]]?.[rule[0]]"/>
                                        <t t-if="rule[4] === 'edit' and props.record.data.state === 'draft'">
                                            <input type="text"
                                                inputmode="decimal"
                                                t-att-value="formatMoney(v, rule, state.decimals?.[rule[0]])"
                                                t-on-focus="(ev) => onValueFocus(ev, rule)"
                                                t-on-input="(ev) => onValueInput(ev, rule)"
                                                t-on-keydown="onValueKeydown"
                                                t-on-change="(ev) => onValueChange(ev, state.employee_lines?.[emp[0]]?.[rule[0]], emp[0], rule[0], rule)"
                                                class="form-control form-control-sm text-end"
                                                style="width:120px;"/>
                                        </t>
                                        <t t-else="">
                                            <span>
                                                <t t-esc="formatMoney(v, rule, state.decimals?.[rule[0]])"/>
                                            </span>
                                        </t>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2" style="width:auto; background-color:#fff; font-weight:700;" class="john oe_payroll_employee">
                                <strong>Нийт дүн</strong>
                            </td>

                            <t t-foreach="state.rules" t-as="rule" t-key="'sum-' + rule[0]">
                                <td class="oe_payroll_rule">
                                    <t t-if="rule[2]">
                                        <t t-set="total" t-value="Object.values(state.employee_values)
                                            .reduce((acc, empVals) => acc + (empVals?.[rule[0]] || 0), 0)"/>
                                        <span>
                                            <strong>
                                                <t t-esc="formatMoney(total, rule, state.decimals?.[rule[0]])"/>
                                            </strong>
                                        </span>
                                    </t>
                                </td>
                            </t>
                        </tr>
                    </tfoot>

                </table>
            </div>
        </div>
    </t>

</templates>