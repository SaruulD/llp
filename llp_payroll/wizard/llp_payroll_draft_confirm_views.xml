<odoo>
    <record id="view_llp_payroll_draft_confirm_form" model="ir.ui.view">
        <field name="name">llp.payroll.draft.confirm.form</field>
        <field name="model">llp.payroll.draft.confirm</field>
        <field name="arch" type="xml">
            <form>
                <field name="payroll_id" invisible="1"/>
                <field name="move_count" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert">
                    Холбоотой ажил гүйлгээг цуцалсны дараа баталсан цалин бодолтыг
                    ноорог төлөвт шилжүүлэх боломжтой, холбоотой ажил гүйлгээг
                    цуцлах уу?
                </div>
                <footer>
                    <button name="action_confirm_cancel_moves" type="object"
                            string="Тийм" class="btn-primary"/>
                    <button name="action_dismiss" type="object"
                            string="Үгүй" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>