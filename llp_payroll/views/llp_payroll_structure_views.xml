<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payroll Structure: Search -->
    <record id="view_llp_payroll_structure_filter" model="ir.ui.view">
        <field name="name">llp.payroll.structure</field>
        <field name="model">llp.payroll.structure</field>
        <field name="arch" type="xml">
            <search string="Search structure">
                <field name="name" />
                <field name="struct_type"/>
                <group expand="0" string="Group By">
                    <filter string="name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Payroll Structure: List View -->
    <record id="view_llp_payroll_structure_list" model="ir.ui.view">
        <field name="name">llp.payroll.structure</field>
        <field name="model">llp.payroll.structure</field>
        <field name="arch" type="xml">
            <list string="Payroll structure">
                <field name="name"/>
                <field name="struct_type"/>
                <field name="company_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_llp_payroll_structure_form" model="ir.ui.view">
        <field name="name">llp.payroll.structure</field>
        <field name="model">llp.payroll.structure</field>
        <field name="arch" type="xml">
            <form string="Payroll Structure">

                <header>
                    <button name="action_confirm" invisible="state != 'draft'" string="Confirm" type="object" class="btn-primary"/>
                    <button name="action_draft" invisible="state != 'done'" string="Draft" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="struct_type"/>
                        <field name="company_id" options="{'no_create': True}" />
                    </group>

                    <notebook>
                        <page string="Rule lines">
                            <field name="line_ids" readonly="state == 'done'">
                                <list string="" editable="bottom">
                                    <field name="rule_id"
                                        required="1"
                                        options="{'no_create': True}"
                                        domain="[('company_id', '=', parent.company_id)]"/>
                                    <field name="rule_code"/>
                                    <field name="sequence"/>
                                    <field name="exp_sequence" options="{'no_create': True}"/>
                                    <field name="company_id"/>
                                    <button name="action_open_rule" string="Дүрэм харах"
                                        type="object"
                                        icon="fa-external-link"
                                        invisible="not rule_id"
                                        readonly="0"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>


    <record id="action_llp_payroll_structure" model="ir.actions.act_window">
        <field name="name">Payroll Structure</field>
        <field name="res_model">llp.payroll.structure</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help">List of payroll structure.</field>
    </record>
</odoo>
			