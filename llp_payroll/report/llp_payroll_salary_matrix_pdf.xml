<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Landscape paperformat олон баганатай матриц тайланд тохиромжтой -->
    <record id="paperformat_llp_payroll_matrix" model="report.paperformat">
        <field name="name">Payroll Matrix Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <!-- PDF Report Action -->
    <record id="action_report_payroll_matrix_pdf" model="ir.actions.report">
        <field name="name">Payroll Report PDF</field>
        <field name="model">llp.payroll.salary.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">llp_payroll.report_payroll_matrix_pdf</field>
        <field name="report_file">llp_payroll.report_payroll_matrix_pdf</field>
        <field name="print_report_name">'Цалингийн тайлан'</field>
        <field name="paperformat_id" ref="paperformat_llp_payroll_matrix"/>
    </record>

    <!-- QWeb Template -->
    <template id="report_payroll_matrix_pdf">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">

                <div class="page">
                    <style>
                        .llp-title {
                            text-align: center;
                            font-size: 16px;
                            font-weight: 700;
                            font-family: Arial, sans-serif;
                            margin: 0 0 10px 0;
                        }
                        .llp-subtitle {
                            text-align: center;
                            font-size: 11px;
                            font-weight: 700;
                            font-family: Arial, sans-serif;
                            margin: 0 0 8px 0;
                            color: #444;
                        }
                        .llp-filters {
                            font-size: 10px;
                            font-family: Arial, sans-serif;
                            margin: 0 0 8px 0;
                        }
                        .llp-filters div {
                            padding: 1px 0;
                        }
                        .llp-table {
                            width: 100%;
                            border-collapse: collapse;
                            font-family: Arial, sans-serif;
                        }
                        .llp-table th, .llp-table td {
                            border: 1px solid #000;
                            padding: 4px 6px;
                            font-size: 10px;
                        }
                        .llp-table th {
                            background: #E0E0E0;
                            text-align: center;
                            font-weight: 700;
                            white-space: nowrap;
                        }
                        thead {
                            display: table-header-group; /* толгойг хуудас бүрт давтана */
                        }
                        .dept-row td {
                            font-weight: 700;
                        }
                        .emp-name {
                            padding-left: 14px;
                            text-align: left;
                            white-space: nowrap;
                        }
                        .val-num {
                            text-align: right;
                            white-space: nowrap;
                        }
                        .val-text {
                            text-align: left;
                            white-space: nowrap;
                        }
                        .total-row td {
                            background: #D9D9D9;
                            font-weight: 700;
                        }
                        .grand-total-row td {
                            background: #D9D9D9;
                            font-weight: 700;
                            border-top: 2px solid #000;
                        }
                        .chunk-break {
                            page-break-before: always;
                        }
                    </style>

                    <div class="llp-title">
                        <t t-esc="vals.get('file_name') or 'Цалингийн тайлан'"/>
                    </div>

                    <div class="llp-filters">
                        <div>Эхлэх хугацаа: <t t-esc="docs.start_date or ''"/></div>
                        <div>Дуусах хугацаа: <t t-esc="docs.end_date or ''"/></div>
                    </div>

                    <!-- ★ Баганыг (дүрэм) 7-7-аар хэсэглэж, багц бүрийг тусдаа
                         хүснэгт болгоно. Мөр (ажилтан) хэзээ ч тасрахгүй,
                         зөвхөн баганууд хэсэг хэсгээрээ дараагийн хуудсанд
                         "Ажилтан" баганатайгаа хамт давтагдана. -->
                    <t t-set="chunk_size" t-value="7"/>
                    <t t-set="rule_chunks" t-value="[vals['rule_ids'][i:i+chunk_size] for i in range(0, len(vals['rule_ids']), chunk_size)] or [[]]"/>

                    <t t-foreach="rule_chunks" t-as="rule_chunk">

                        <div t-attf-class="#{'chunk-break' if not rule_chunk_first else ''}">

                            <t t-if="not rule_chunk_first">
                                <div class="llp-subtitle">
                                    <t t-esc="vals.get('file_name') or 'Цалингийн тайлан'"/> (үргэлжлэл — <t t-esc="rule_chunk_index + 1"/>/<t t-esc="rule_chunk_size"/>)
                                </div>
                            </t>

                            <table class="llp-table">
                                <thead>
                                    <tr>
                                        <th>Ажилтан</th>
                                        <t t-foreach="rule_chunk" t-as="rid">
                                            <th>
                                                <t t-esc="vals['rules_map'][rid][1]"/>
                                            </th>
                                        </t>
                                    </tr>
                                </thead>

                                <tbody>
                                    <t t-set="grand" t-value="{}"/>

                                    <t t-foreach="sorted(vals['payrolls'].values(), key=lambda p: p.get('department_name') or '')" t-as="p">

                                        <t t-set="dept" t-value="{}"/>

                                        <tr class="dept-row">
                                            <td>
                                                <t t-esc="p.get('department_name') or 'Тодорхойгүй'"/>
                                            </td>
                                            <t t-foreach="rule_chunk" t-as="rid">
                                                <td></td>
                                            </t>
                                        </tr>

                                        <t t-foreach="sorted(p['employees'].values(), key=lambda e: ((e.get('lastname') or ''), (e.get('firstname') or '')))" t-as="emp">
                                            <tr>
                                                <td class="emp-name">
                                                    <t t-esc="emp.get('lastname') or 'Тодорхойгүй'"/>
                                                    <t t-esc="' '"/>
                                                    <t t-esc="emp.get('firstname') or 'Тодорхойгүй'"/>
                                                </td>

                                                <t t-foreach="rule_chunk" t-as="rid">
                                                    <t t-set="r" t-value="emp['rules'].get(rid)"/>
                                                    <t t-if="r and r.get('rulefield_type') == 'sign'">
                                                        <td class="val-text">
                                                            <t t-esc="r.get('char_value') or ''"/>
                                                        </td>
                                                    </t>
                                                    <t t-else="">
                                                        <td class="val-num">
                                                            <t t-if="r">
                                                                <t t-esc="'{:,.2f}'.format(float(r.get('value') or 0.0))"/>
                                                                <t t-if="r.get('is_show_sum')">
                                                                    <t t-set="tmp_dept" t-value="dept.update({rid: (dept.get(rid, 0.0) + float(r.get('value') or 0.0))})"/>
                                                                </t>
                                                            </t>
                                                        </td>
                                                    </t>
                                                </t>
                                            </tr>
                                        </t>

                                        <tr class="total-row">
                                            <td>Албаны нийт дүн</td>

                                            <t t-foreach="rule_chunk" t-as="rid">
                                                <t t-set="rtype" t-value="vals['rules_map'][rid][2]"/>
                                                <t t-set="show_sum" t-value="vals['rules_map'][rid][3]"/>

                                                <td class="val-num">
                                                    <t t-if="show_sum and rtype != 'sign'">
                                                        <t t-esc="'{:,.2f}'.format(dept.get(rid, 0.0))"/>
                                                        <t t-set="tmp_grand" t-value="grand.update({rid: (grand.get(rid, 0.0) + dept.get(rid, 0.0))})"/>
                                                    </t>
                                                </td>
                                            </t>
                                        </tr>

                                    </t>

                                    <!-- Grand total row (энэ багцын баганад л хамаарна) -->
                                    <tr class="grand-total-row">
                                        <td>НИЙТ ДҮН</td>
                                        <t t-foreach="rule_chunk" t-as="rid">
                                            <t t-set="rtype" t-value="vals['rules_map'][rid][2]"/>
                                            <t t-set="show_sum" t-value="vals['rules_map'][rid][3]"/>
                                            <td class="val-num">
                                                <t t-if="show_sum and rtype != 'sign'">
                                                    <t t-esc="'{:,.2f}'.format(grand.get(rid, 0.0))"/>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>

                                </tbody>
                            </table>
                        </div>

                    </t>

                </div>
            </t>
        </t>
    </template>

</odoo>