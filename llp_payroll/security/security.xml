<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_llp_payroll">
        <field name="name">LLP Payroll</field>
        <field name="description">Helps you handle your payrolls.</field>
        <field name="sequence">1</field>
    </record>

    <record id="group_payroll_user" model="res.groups">
        <field name="name">Цалин хэрэглэгч</field>
        <field name="category_id" ref="module_llp_payroll"/>
    </record>

    <record id="group_payroll_admin" model="res.groups">
        <field name="name">Цалин админ</field>
        <field name="category_id" ref="module_llp_payroll"/>
        <field name="implied_ids" eval="[(4, ref('llp_payroll.group_payroll_user'))]"/>
    </record>

    <record id="group_payroll_accountant" model="res.groups">
        <field name="name">Цалин нягтлан</field>
        <field name="category_id" ref="module_llp_payroll"/>
        <field name="implied_ids" eval="[(4, ref('llp_payroll.group_payroll_user'))]"/>
    </record>

    <record model="ir.rule" id="show_companys_payroll_debt">
        <field name="name">Компанийхаа мэдээллийг харах - debt</field>
        <field name="model_id" ref="model_llp_payroll_employee_debt"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record> 

    <record model="ir.rule" id="show_companys_payroll">
        <field name="name">Компанийхаа мэдээллийг харах</field>
        <field name="model_id" ref="model_llp_payroll"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record> 

    <record model="ir.rule" id="show_companys_payroll_vacation">
        <field name="name">Компанийхаа мэдээллийг харах - vacaion</field>
        <field name="model_id" ref="model_llp_payroll_employee_vacation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record> 
    <record model="ir.rule" id="show_companys_payroll_rule">
        <field name="name">Компанийхаа мэдээллийг харах - rule</field>
        <field name="model_id" ref="model_llp_payroll_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record> 
    <record model="ir.rule" id="show_companys_payroll_structure">
        <field name="name">Компанийхаа мэдээллийг харах - structure</field>
        <field name="model_id" ref="model_llp_payroll_structure"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record> 
    <record model="ir.rule" id="show_companys_payroll_report">
        <field name="name">Компанийхаа мэдээллийг харах - report</field>
        <field name="model_id" ref="model_llp_payroll_report_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record> 
    <record model="ir.rule" id="show_companys_payroll_unit">
        <field name="name">Компанийхаа мэдээллийг харах - unit</field>
        <field name="model_id" ref="model_llp_payroll_unit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record> 
</odoo>