    <record id="rule_payroll_payroll_assigned_company" model="ir.rule">
        <field name="name">Цалин - зөвшөөрөгдсөн компани (з)</field>
        <field name="model_id" ref="model_llp_payroll" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in',
            company_ids)]</field>
        <field name="groups"
            eval="[(4, ref('llp_payroll.group_payroll_accountant')),
                                     (4, ref('llp_payroll.group_payroll_exec_director'))]" />
    </record>

